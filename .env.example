# Copy to .env for local overrides. In production these are set as real
# environment variables via the gunicorn systemd unit's EnvironmentFile=
# (see deploy/no-bias-essay-grader.service) — this file is never read there.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
